{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RealWareApiSettings": {
    "BaseUrl": "http://{your server name}/{your instance name}/EncompassAPI/",
    "ApiKey": "{your realware api key here}",
    "UseRealWareApiInCostCalculation": false,
    "UseRealWareApiInIncomeCalculation": false,
    "UseRealWareApiInMarketCalculation": false
  },
  "AllowedHosts": "*"
}
